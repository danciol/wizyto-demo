# Zmienne środowiskowe projektu salonu na Vercelu (Settings → Environment Variables).
# Nie wpisuj prawdziwych wartości do tego pliku — to tylko lista.

# ── Zaliczki online (Tpay) ──────────────────────────────────────
# Panel Tpay → Integracja → API → Klucze Open API (sekret widać tylko raz, przy generowaniu)
TPAY_CLIENT_ID=
TPAY_CLIENT_SECRET=
# Opcjonalnie: Panel Tpay → Powiadomienia → Bezpieczeństwo. Gdy podany, oprócz podpisu JWS sprawdzamy też md5sum.
TPAY_SECURITY_CODE=
# true na koncie testowym (panel.sandbox.tpay.com), usuń na produkcji
TPAY_SANDBOX=true

# Klucz konta serwisowego Firebase salonu — cały JSON w jednej linii.
# Firebase Console → Ustawienia projektu → Konta usługi → Wygeneruj nowy klucz prywatny
FIREBASE_SERVICE_ACCOUNT=

# Opcjonalnie: adres strony salonu, jeśli inny niż domena zapytania (np. https://twojsalon.pl)
SITE_URL=
# Opcjonalnie: zabezpieczenie codziennego sprzątania nieopłaconych rezerwacji (Vercel dokleja je do crona)
CRON_SECRET=
